{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "palette": [
        {
          "name": "Primary (BBC Red)",
          "slug": "primary",
          "color": "#B80000"
        },
        {
          "name": "Primary Dark",
          "slug": "primary-dark",
          "color": "#8A0000"
        },
        {
          "name": "Background",
          "slug": "bg",
          "color": "#FFFFFF"
        },
        {
          "name": "Background Soft",
          "slug": "bg-soft",
          "color": "#F8FAFC"
        },
        {
          "name": "Text Main",
          "slug": "text",
          "color": "#0F172A"
        },
        {
          "name": "Text Muted",
          "slug": "text-muted",
          "color": "#64748B"
        },
        {
          "name": "Border",
          "slug": "border",
          "color": "#E2E8F0"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "IRANYekanX, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
          "name": "IRANYekanX",
          "slug": "iranyekan"
        }
      ],
      "fontSizes": [
        {
          "name": "کوچک (Small)",
          "size": "0.75rem",
          "slug": "small"
        },
        {
          "name": "معمولی (Normal)",
          "size": "0.875rem",
          "slug": "normal"
        },
        {
          "name": "متوسط (Medium)",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "بزرگ (Large)",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "بسیار بزرگ (Extra Large)",
          "size": "1.5rem",
          "slug": "x-large"
        },
        {
          "name": "تیتر ۲X (2X Large)",
          "size": "2rem",
          "slug": "2x-large"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vh", "vw"]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--iranyekan)",
      "lineHeight": "1.75"
    },
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--text)"
    }
  }
}
